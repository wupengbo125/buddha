{
  "name": "buddha",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "pnpm": {
    "neverBuiltDependencies": [
      "rclone.js"
    ],
    "overrides": {
      "postcss": "8.4.46",
      "fast-xml-parser": "4.5.7",
      "undici": "7.30.2"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply buddha --local",
    "db:migrate:remote": "wrangler d1 migrations apply buddha --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "jose": "5.6.3",
    "lucide-react": "1.44.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "2.4.0",
    "ulid": "2.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@opennextjs/cloudflare": "1.20.11",
    "@types/node": "20.14.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.46",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3",
    "vitest": "2.0.3",
    "wrangler": "4.148.0"
  }
}
